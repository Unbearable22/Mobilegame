## Canonical metadata for the same Board renderer used by gameplay.
static func preview_level(kind: String) -> Dictionary:
	var definition: Dictionary = {"x":0,"y":0,"type":kind}
	match kind:
		"source", "directional": definition.dirs = [1]
		"splitter": definition.dirs = [0,1]
		"and_gate": definition.dirs = [1]
		"delay":
			definition.dirs = [1]
			definition.delay_ticks = 2
		"portal":
			definition.pair_id = "guide_pair"
			definition.dirs = [1]
	definition.rotatable = kind in ["directional","splitter","reflector","and_gate","delay"]
	if kind == "portal":
		return {"width":3,"height":1,"nodes":[definition,{"x":2,"y":0,"type":"portal","pair_id":"guide_pair","dirs":[3]}]}
	return {"width":1,"height":1,"nodes":[definition]}
